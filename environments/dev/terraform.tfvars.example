# Copy to terraform.tfvars and fill in. terraform.tfvars is git-ignored.

# Your public IP as a /32: curl -s https://checkip.amazonaws.com
ssh_allowed_cidrs = ["203.0.113.10/32"]

# Contents of your public key, e.g. ~/.ssh/id_ed25519.pub
ssh_public_key = "ssh-ed25519 AAAA... you@example.com"

# Receives CloudWatch alarm and budget emails. Confirm the SNS subscription email.
alarm_email = "you@example.com"

# Optional overrides
# region              = "us-east-1"
# instance_type       = "t2.micro"
# nat_gateway_enabled = false
# web_min_size        = 1
# web_max_size        = 3
# monthly_budget_usd  = 10
