# Local .terraform directories
.terraform/

# .tfstate files
*.tfstate
*.tfstate.*

# Ignore transient lock info files created by terraform apply
.terraform.tfstate.lock.info

# Saved plans
*.tfplan
tfplan

# Crash log files
crash.log
crash.*.log

# Variable files may contain IPs, emails and keys - commit the *.example files instead
*.tfvars
*.tfvars.json
!*.tfvars.example
backend.hcl

# Ignore override files as they are usually used to override resources locally
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Ignore CLI configuration files
.terraformrc
terraform.rc

# IDE files
.idea
.vscode/*
.history/
