# Container start-up for the ECS nginx task (nginx:stable-alpine).
# ADMIN_USERNAME / ADMIN_PASSWORD are injected by ECS from Secrets Manager.
set -eu

# --- Task identity (ECS task metadata endpoint v4) -----------------------------
META=$(wget -q -O - "$ECS_CONTAINER_METADATA_URI_V4/task" 2>/dev/null || true)
TASK_ID=$(printf '%s' "$META" | sed -n 's/.*"TaskARN":"[^"]*\/\([^"]*\)".*/\1/p')
AZ=$(printf '%s' "$META" | sed -n 's/.*"AvailabilityZone":"\([^"]*\)".*/\1/p')

# --- Web content ----------------------------------------------------------------
cat > /usr/share/nginx/html/index.html <<HTML
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <title>Hello, World!</title>
</head>
<body>
  <h1>Hello, World!</h1>
  <p>Served by ECS task $TASK_ID in $AZ</p>
</body>
</html>
HTML

mkdir -p /usr/share/nginx/html/admin
cat > /usr/share/nginx/html/admin/index.html <<'HTML'
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <title>Admin</title>
</head>
<body>
  <h1>Admin area</h1>
  <p>You authenticated with credentials stored in AWS Secrets Manager.</p>
</body>
</html>
HTML

# --- Admin credentials: hash the injected password, then drop the plaintext ----
install -m 0640 -o root -g nginx /dev/null /etc/nginx/.htpasswd
printf '%s:%s\n' "$ADMIN_USERNAME" "$(printf '%s' "$ADMIN_PASSWORD" | mkpasswd -m sha512 -P 0)" > /etc/nginx/.htpasswd
unset ADMIN_PASSWORD

# --- nginx ----------------------------------------------------------------------
cat > /etc/nginx/conf.d/default.conf <<'NGINX'
server {
    listen      80;
    server_name _;
    server_tokens off;
    root        /usr/share/nginx/html;

    location / {
        index index.html;
    }

    location = ${health_check_path} {
        access_log off;
        default_type text/plain;
        return 200 "ok";
    }

    location /admin/ {
        auth_basic           "Restricted";
        auth_basic_user_file /etc/nginx/.htpasswd;
    }
}
NGINX

nginx -t
# exec replaces the shell, so nginx starts without ADMIN_PASSWORD in its
# environment.
exec nginx -g 'daemon off;'
